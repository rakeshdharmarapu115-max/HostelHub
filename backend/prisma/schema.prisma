generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// 1. Users & Profiles
// -----------------------------------------------------------------------------

model User {
  id           String    @id @default(uuid()) @map("user_id")
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         String    @default("STUDENT")
  fullName     String    @map("full_name")
  phoneNumber  String?   @map("phone_number")
  avatarUrl    String?   @map("avatar_url")
  isActive     Boolean   @default(true) @map("is_active")
  fcmToken     String?   @map("fcm_token")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  hostProfile       Host?
  adminProfile      Admin?
  studentProfile    Student?
  staffProfile      Staff?
  allocationsMade   RoomAllocation[]
  paymentsVerified  Payment[]
  leaveApprovals    LeaveRequest[]
  visitorsApproved  Visitor[]
  announcementsSent Announcement[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  refreshTokens     RefreshToken[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Host {
  id             String   @id @default(uuid()) @map("host_id")
  userId         String   @unique @map("user_id")
  fullName       String   @map("full_name")
  businessName   String   @map("business_name")
  contactPhone   String   @map("contact_phone")
  contactEmail   String   @map("contact_email")
  verifiedStatus Boolean  @default(false) @map("verified_status")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hostels Hostel[]

  @@map("hosts")
}

model Admin {
  id              String   @id @default(uuid()) @map("admin_id")
  userId          String   @unique @map("user_id")
  fullName        String   @map("full_name")
  associationName String   @map("association_name")
  designation     String
  permissions     String   @default("ALL")
  contactPhone    String?  @map("contact_phone")
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admins")
}

model Student {
  id                    String    @id @default(uuid()) @map("student_id")
  userId                String    @unique @map("user_id")
  fullName              String    @map("full_name")
  rollNumber            String    @unique @map("roll_number")
  collegeName           String    @map("college_name")
  course                String
  yearOfStudy           String    @default("1") @map("year_of_study")
  gender                String    @default("male")
  permanentAddress      String    @map("permanent_address")
  emergencyContactName  String    @map("emergency_contact_name")
  emergencyContactPhone String    @map("emergency_contact_phone")
  hostelId              String?   @map("hostel_id")
  hostelName            String?   @map("hostel_name")
  roomId                String?   @map("room_id")
  roomNumber            String?   @map("room_number")
  bedNumber             String?   @map("bed_number")
  admissionDate         DateTime? @map("admission_date")
  status                String    @default("ACTIVE")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  hostel            Hostel?            @relation(fields: [hostelId], references: [id], onDelete: SetNull)
  room              Room?              @relation(fields: [roomId], references: [id], onDelete: SetNull)
  allocations       RoomAllocation[]
  fees              Fee[]
  payments          Payment[]
  complaints        Complaint[]
  leaveRequests     LeaveRequest[]
  attendanceRecords AttendanceRecord[]
  visitors          Visitor[]
  reviews           HostelReview[]

  @@index([hostelId])
  @@index([rollNumber])
  @@map("students")
}

// -----------------------------------------------------------------------------
// 2. Hostels, Blocks, Floors, Rooms & Beds
// -----------------------------------------------------------------------------

model Hostel {
  id              String   @id @default(uuid()) @map("hostel_id")
  hostId          String   @map("host_id")
  name            String
  address         String
  city            String
  state           String   @default("")
  postalCode      String   @default("") @map("postal_code")
  latitude        Float    @default(0.0)
  longitude       Float    @default(0.0)
  description     String?
  genderType      String   @default("COED") @map("gender_type")
  amenities       String   @default("[]")
  rules           String   @default("[]")
  images          String   @default("[]")
  totalRooms      Int      @default(0) @map("total_rooms")
  totalBeds       Int      @default(0) @map("total_beds")
  occupiedBeds    Int      @default(0) @map("occupied_beds")
  baseMonthlyRent Float    @default(0.0) @map("base_monthly_rent")
  cautionDeposit  Float    @default(0.0) @map("caution_deposit")
  rating          Float    @default(0.0)
  ratingCount     Int      @default(0) @map("rating_count")
  contactEmail    String?  @map("contact_email")
  contactPhone    String?  @map("contact_phone")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  host              Host               @relation(fields: [hostId], references: [id], onDelete: Restrict)
  blocks            Block[]
  floors            Floor[]
  rooms             Room[]
  students          Student[]
  allocations       RoomAllocation[]
  staff             Staff[]
  feeTypes          FeeType[]
  fees              Fee[]
  payments          Payment[]
  complaints        Complaint[]
  maintenanceLogs   MaintenanceLog[]
  leaveRequests     LeaveRequest[]
  attendanceRecords AttendanceRecord[]
  visitors          Visitor[]
  foodMenus         FoodMenu[]
  reviews           HostelReview[]

  @@index([city])
  @@index([genderType])
  @@map("hostels")
}

model Block {
  id          String   @id @default(uuid()) @map("block_id")
  hostelId    String   @map("hostel_id")
  blockName   String   @map("block_name")
  totalFloors Int      @default(1) @map("total_floors")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  hostel Hostel  @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  floors Floor[]
  rooms  Room[]

  @@unique([hostelId, blockName])
  @@map("blocks")
}

model Floor {
  id          String   @id @default(uuid()) @map("floor_id")
  blockId     String   @map("block_id")
  hostelId    String   @map("hostel_id")
  floorNumber Int      @map("floor_number")
  totalRooms  Int      @default(0) @map("total_rooms")
  createdAt   DateTime @default(now()) @map("created_at")

  block  Block  @relation(fields: [blockId], references: [id], onDelete: Cascade)
  hostel Hostel @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  rooms  Room[]

  @@unique([blockId, floorNumber])
  @@map("floors")
}

model Room {
  id            String   @id @default(uuid()) @map("room_id")
  hostelId      String   @map("hostel_id")
  blockId       String?  @map("block_id")
  floorId       String?  @map("floor_id")
  roomNumber    String   @map("room_number")
  floor         Int      @default(1)
  block         String   @default("A")
  roomType      String   @default("DOUBLE") @map("room_type")
  totalCapacity Int      @default(2) @map("total_capacity")
  occupiedCount Int      @default(0) @map("occupied_count")
  monthlyRent   Float    @default(0.0) @map("monthly_rent")
  amenities     String   @default("[]")
  status        String   @default("AVAILABLE")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  hostel          Hostel           @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  blockRel        Block?           @relation(fields: [blockId], references: [id], onDelete: SetNull)
  floorRel        Floor?           @relation(fields: [floorId], references: [id], onDelete: SetNull)
  beds            Bed[]
  students        Student[]
  allocations     RoomAllocation[]
  fees            Fee[]
  maintenanceLogs MaintenanceLog[]

  @@unique([hostelId, roomNumber])
  @@index([hostelId])
  @@index([status])
  @@map("rooms")
}

model Bed {
  id         String   @id @default(uuid()) @map("bed_id")
  roomId     String   @map("room_id")
  bedNumber  String   @map("bed_number")
  isOccupied Boolean  @default(false) @map("is_occupied")
  createdAt  DateTime @default(now()) @map("created_at")

  room        Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  allocations RoomAllocation[]

  @@unique([roomId, bedNumber])
  @@index([roomId])
  @@map("beds")
}

model RoomAllocation {
  id             String    @id @default(uuid()) @map("allocation_id")
  bedId          String    @map("bed_id")
  roomId         String    @map("room_id")
  hostelId       String    @map("hostel_id")
  studentId      String    @map("student_id")
  allocationDate DateTime  @default(now()) @map("allocation_date")
  checkInDate    DateTime? @map("check_in_date")
  checkOutDate   DateTime? @map("check_out_date")
  status         String    @default("ACTIVE")
  allocatedBy    String?   @map("allocated_by")
  remarks        String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  bed          Bed     @relation(fields: [bedId], references: [id], onDelete: Restrict)
  room         Room    @relation(fields: [roomId], references: [id], onDelete: Restrict)
  hostel       Hostel  @relation(fields: [hostelId], references: [id], onDelete: Restrict)
  student      Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  adminOrWarden User?  @relation(fields: [allocatedBy], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([bedId])
  @@index([status])
  @@map("room_allocations")
}

// -----------------------------------------------------------------------------
// 3. Staff, Fees, Payments, Complaints, Logs
// -----------------------------------------------------------------------------

model Staff {
  id          String   @id @default(uuid()) @map("staff_id")
  userId      String?  @unique @map("user_id")
  hostelId    String   @map("hostel_id")
  fullName    String   @map("full_name")
  roleTitle   String   @map("role_title")
  phone       String
  email       String?
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at")

  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  hostel          Hostel           @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  maintenanceLogs MaintenanceLog[]

  @@map("staff")
}

model FeeType {
  id            String   @id @default(uuid()) @map("fee_type_id")
  hostelId      String   @map("hostel_id")
  name          String
  defaultAmount Float    @default(0.0) @map("default_amount")
  billingCycle  String   @default("MONTHLY") @map("billing_cycle")
  createdAt     DateTime @default(now()) @map("created_at")

  hostel Hostel @relation(fields: [hostelId], references: [id], onDelete: Cascade)

  @@map("fee_types")
}

model Fee {
  id           String   @id @default(uuid()) @map("fee_id")
  hostelId     String   @map("hostel_id")
  studentId    String   @map("student_id")
  roomId       String?  @map("room_id")
  title        String
  feeType      String   @default("RENT") @map("fee_type")
  amount       Float
  amountPaid   Float    @default(0.0) @map("amount_paid")
  dueDate      DateTime @map("due_date")
  billingMonth Int      @map("billing_month")
  billingYear  Int      @map("billing_year")
  status       String   @default("PENDING")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  hostel   Hostel    @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  student  Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  room     Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  payments Payment[]

  @@index([studentId])
  @@index([hostelId])
  @@index([status])
  @@map("fees")
}

model Payment {
  id                   String   @id @default(uuid()) @map("payment_id")
  feeId                String   @map("fee_id")
  studentId            String   @map("student_id")
  hostelId             String   @map("hostel_id")
  amountPaid           Float    @map("amount_paid")
  paymentMethod        String   @default("UPI") @map("payment_method")
  transactionReference String   @unique @map("transaction_reference")
  paymentDate          DateTime @default(now()) @map("payment_date")
  receiptUrl           String?  @map("receipt_url")
  status               String   @default("SUCCESS")
  verifiedByHostId     String?  @map("verified_by_host_id")
  remarks              String?
  createdAt            DateTime @default(now()) @map("created_at")

  fee            Fee     @relation(fields: [feeId], references: [id], onDelete: Restrict)
  student        Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  hostel         Hostel  @relation(fields: [hostelId], references: [id], onDelete: Restrict)
  verifiedByHost User?   @relation(fields: [verifiedByHostId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([feeId])
  @@map("payments")
}

model Complaint {
  id                String    @id @default(uuid()) @map("complaint_id")
  hostelId          String    @map("hostel_id")
  studentId         String    @map("student_id")
  studentName       String    @map("student_name")
  roomNumber        String    @map("room_number")
  category          String    @default("OTHER")
  title             String
  description       String
  attachments       String    @default("[]")
  urgency           String    @default("MEDIUM")
  status            String    @default("OPEN")
  assignedStaffName String?   @map("assigned_staff_name")
  hostNotes         String?   @map("host_notes")
  resolutionSummary String?   @map("resolution_summary")
  createdAt         DateTime  @default(now()) @map("created_at")
  resolvedAt        DateTime? @map("resolved_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  hostel          Hostel           @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  maintenanceLogs MaintenanceLog[]

  @@index([hostelId])
  @@index([studentId])
  @@index([status])
  @@map("complaints")
}

model MaintenanceLog {
  id                 String   @id @default(uuid()) @map("maintenance_id")
  complaintId        String?  @map("complaint_id")
  hostelId           String   @map("hostel_id")
  roomId             String?  @map("room_id")
  performedByStaffId String?  @map("performed_by_staff_id")
  issueType          String   @map("issue_type")
  actionTaken        String   @map("action_taken")
  cost               Float    @default(0.0)
  maintenanceDate    DateTime @default(now()) @map("maintenance_date")
  createdAt          DateTime @default(now()) @map("created_at")

  complaint Complaint? @relation(fields: [complaintId], references: [id], onDelete: SetNull)
  hostel    Hostel     @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  room      Room?      @relation(fields: [roomId], references: [id], onDelete: SetNull)
  staff     Staff?     @relation(fields: [performedByStaffId], references: [id], onDelete: SetNull)

  @@map("maintenance_logs")
}

model LeaveRequest {
  id                    String   @id @default(uuid()) @map("leave_id")
  studentId             String   @map("student_id")
  hostelId              String   @map("hostel_id")
  startDate             String   @map("start_date")
  endDate               String   @map("end_date")
  reason                String
  emergencyContactPhone String?  @map("emergency_contact_phone")
  status                String   @default("PENDING")
  approvedBy            String?  @map("approved_by")
  rejectionReason       String?  @map("rejection_reason")
  remarks               String?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  student           Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  hostel            Hostel             @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  approver          User?              @relation(fields: [approvedBy], references: [id], onDelete: SetNull)
  attendanceRecords AttendanceRecord[]

  @@index([studentId])
  @@index([hostelId])
  @@map("leave_requests")
}

model AttendanceRecord {
  id             String    @id @default(uuid()) @map("attendance_id")
  hostelId       String    @map("hostel_id")
  studentId      String    @map("student_id")
  studentName    String    @map("student_name")
  roomNumber     String    @map("room_number")
  date           String
  status         String    @default("PRESENT")
  checkInTime    DateTime? @map("check_in_time")
  remarks        String?
  markedBy       String    @default("STUDENT_SELF") @map("marked_by")
  leaveRequestId String?   @map("leave_request_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  hostel       Hostel        @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  leaveRequest LeaveRequest? @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)

  @@unique([studentId, date])
  @@index([studentId, date])
  @@index([hostelId, date])
  @@map("attendance_records")
}

model Visitor {
  id             String    @id @default(uuid()) @map("visitor_id")
  hostelId       String    @map("hostel_id")
  studentId      String    @map("student_id")
  visitorName    String    @map("visitor_name")
  relationship   String
  phone          String
  idProofType    String?   @map("id_proof_type")
  idProofNumber  String?   @map("id_proof_number")
  purpose        String
  checkInTime    DateTime  @default(now()) @map("check_in_time")
  checkOutTime   DateTime? @map("check_out_time")
  approvedBy     String?   @map("approved_by")
  status         String    @default("INSIDE")
  remarks        String?
  createdAt      DateTime  @default(now()) @map("created_at")

  hostel   Hostel  @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  approver User?   @relation(fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([hostelId])
  @@map("visitors")
}

model FoodMenu {
  id            String   @id @default(uuid()) @map("menu_id")
  hostelId      String   @map("hostel_id")
  weekStartDate String   @map("week_start_date")
  scheduleJson  String   @map("schedule_json")
  specialNotice String?  @map("special_notice")
  isPublished   Boolean  @default(true) @map("is_published")
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdAt     DateTime @default(now()) @map("created_at")

  hostel Hostel @relation(fields: [hostelId], references: [id], onDelete: Cascade)

  @@unique([hostelId, weekStartDate])
  @@map("food_menus")
}

model Announcement {
  id             String    @id @default(uuid()) @map("announcement_id")
  hostelId       String    @default("GLOBAL_CAMPUS") @map("hostel_id")
  senderId       String    @map("sender_id")
  senderRole     String    @default("HOST") @map("sender_role")
  senderName     String    @map("sender_name")
  title          String
  message        String
  priority       String    @default("NORMAL")
  targetAudience String    @default("ALL") @map("target_audience")
  attachmentUrls String    @default("[]") @map("attachment_urls")
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime? @map("expires_at")

  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([hostelId])
  @@map("announcements")
}

model Notification {
  id              String   @id @default(uuid()) @map("notification_id")
  recipientUserId String   @map("recipient_user_id")
  title           String
  body            String
  type            String   @default("ANNOUNCEMENT")
  relatedEntityId String?  @map("related_entity_id")
  isRead          Boolean  @default(false) @map("is_read")
  createdAt       DateTime @default(now()) @map("created_at")

  recipient User @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, isRead])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid()) @map("log_id")
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  details    String?
  ipAddress  String?  @map("ip_address")
  timestamp  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([timestamp])
  @@map("audit_logs")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("refresh_tokens")
}

model HostelReview {
  id              String   @id @default(uuid()) @map("review_id")
  hostelId        String   @map("hostel_id")
  studentId       String   @map("student_id")
  studentName     String   @map("student_name")
  rating          Float
  comment         String?
  cleanliness     Float?   @default(5.0)
  foodQuality     Float?   @default(5.0)
  amenitiesRating Float?   @default(5.0)
  createdAt       DateTime @default(now()) @map("created_at")

  hostel  Hostel  @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([hostelId])
  @@index([studentId])
  @@map("hostel_reviews")
}
